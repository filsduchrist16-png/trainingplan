{
  "name": "sentier",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "description": "Sentier — générateur de plans d'entraînement course sur route et trail, local-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
